# .env

# --- 核心 LLM 设置 ---
# 火山引擎 Ark 默认地址 (兼容 OpenAI 格式)
VITE_API_BASE=https://ark.cn-beijing.volces.com/api/v3

# 你的 API Key (火山引擎通常不需要 Bearer 前缀，但这里填入即可)
VITE_API_KEY=fb7d31fe-1a46-477a-9965-fa75e36dd11c

# 模型列表 (Endpoint ID)，用英文逗号分隔
# 注意：火山引擎使用的是 endpoint-id (例如 ep-2025...)
VITE_MODEL_LIST=deepseek-v3-1-terminus, deepseek-v3-2-251201

# --- Stable Diffusion 生图设置 ---
# 注意：部署到 Cloudflare 后必须使用 HTTPS 地址 (如 ngrok 穿透地址)
# 本地开发时可以使用 http://127.0.0.1:7860
VITE_SD_URL=https://your-sd-tunnel-url.ngrok.io

# --- 百度翻译设置 (可选，用于将中文 Prompt 转英文给 SD) ---
VITE_BAIDU_APPID=20251013002474609
VITE_BAIDU_SECRET=L2UobrXOASDu4V4tx4Au